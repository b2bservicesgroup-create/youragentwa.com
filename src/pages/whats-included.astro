---
import SectionPage from '../components/SectionPage.astro';
import { services } from '../data/site';
---

<SectionPage
  slug="whats-included"
  title="What's Included in Your $400 Washington LLC"
  description="Your $400 Washington LLC includes the $200 state filing, Certificate of Formation, business license application, one trade name (DBA), EIN and a checklist."
  eyebrow="What's included"
  intro="One flat price covers everything a basic Washington LLC needs to open for business, state fees included. Here is exactly what you get, and what costs extra."
>
  <!-- Services -->
  <section id="services" class="bg-white scroll-mt-24">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-12">
      <div class="max-w-2xl flex flex-col gap-4">
        <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Everything a basic Washington LLC needs, for one price</h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="bg-sky2 rounded-[18px] p-7 flex gap-[18px]">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-accent text-white font-heading font-extrabold text-xl flex items-center justify-center">{s.num}</div>
            <div>
              <h3 class="font-heading text-xl text-navy mb-1.5">{s.title}</h3>
              <p class="text-muted">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fees callout -->
  <section class="bg-navy text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-18 flex flex-wrap gap-10 items-center">
      <div class="flex-1 min-w-[320px] flex flex-col gap-3.5">
        <div class="text-[#8EC2FF] font-bold text-sm tracking-widest uppercase">Know before you file</div>
        <h2 class="font-heading font-extrabold text-3xl md:text-[38px] leading-tight">What's not included</h2>
        <p class="text-lg text-[#D6E4F5]">
          Some businesses need more than a basic state license. If yours does, we'll tell you up front and add only the actual government fee.
        </p>
      </div>
      <div class="flex-1 min-w-[320px] grid gap-4 sm:grid-cols-2">
        <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
          <div class="font-heading font-bold text-lg mb-1.5">City licenses</div>
          <div class="text-[#D6E4F5] text-base">Many Washington cities require their own business license, with fees set by the city.</div>
        </div>
        <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
          <div class="font-heading font-bold text-lg mb-1.5">State endorsements</div>
          <div class="text-[#D6E4F5] text-base">Some industries need state endorsements or specialty licenses, each with its own fee.</div>
        </div>
        <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
          <div class="font-heading font-bold text-lg mb-1.5">Extra trade names</div>
          <div class="text-[#D6E4F5] text-base">One is included. Additional trade names are $5 each, the state fee.</div>
        </div>
        <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
          <div class="font-heading font-bold text-lg mb-1.5">Expedited filing</div>
          <div class="text-[#D6E4F5] text-base">Available if you need it faster, for the state's expedite fee.</div>
        </div>
      </div>
    </div>
  </section>

</SectionPage>
