---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { guides } from '../data/guides';

const bookingURL = 'https://b2bservicesgroup.zohobookings.com/#/b2bservicesgroup';
const startURL = '/llc';

const whyCards = [
  {
    title: 'Protect your personal assets',
    body: 'An LLC separates business debts and liabilities from your home, savings and personal property when it is set up and run correctly.',
    icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z',
  },
  {
    title: 'Look established from day one',
    body: 'Customers, lenders and vendors take a registered business more seriously than a sole proprietor working under a personal name.',
    icon: 'M4 20h16M6 20V9l6-5 6 5v11M10 20v-5h4v5',
  },
  {
    title: 'Open business bank accounts',
    body: 'With your LLC, EIN and business license in place, you can open accounts that keep business and personal money apart.',
    icon: 'M3 10h18M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18M12 3l9 5H3z',
  },
  {
    title: 'Get it right the first time',
    body: 'Washington splits LLC setup between the Secretary of State and the Department of Revenue. We handle both so nothing gets missed.',
    icon: 'M5 12l5 5 9-10',
  },
];

const services = [
  { num: 1, title: 'Certificate of Formation', body: 'We prepare and file your LLC with the Washington Secretary of State.' },
  { num: 2, title: 'State business license', body: 'We file your Washington Business License Application with the Department of Revenue.' },
  { num: 3, title: 'Trade name (DBA)', body: 'One trade name is included, so you can do business under your name without "LLC."' },
  { num: 4, title: 'EIN setup', body: 'We obtain your Employer Identification Number from the IRS so you can bank, hire and file.' },
  { num: 5, title: 'New business checklist', body: 'A clear list of what your new LLC needs next, from accounts to records.' },
  { num: 6, title: 'Local Washington team', body: 'Real people in Rochester, WA, not a national call center. Call, text or meet with us.' },
];

const included = [
  'Washington Certificate of Formation filing fee ($200)',
  'Washington Business License Application fee',
  'One trade name (DBA), state fee included',
  'EIN obtained from the IRS',
  'A checklist of everything your new LLC needs next',
  'Our preparation and filing service',
];

// Published rates as of November 2026. Review before each update.
const compareRows = [
  { label: 'Service fee', b2b: 'Included', lz: '$249', zb: '$199' },
  { label: 'WA Certificate of Formation ($200)', b2b: 'Included', lz: '+ $200', zb: '+ $200' },
  { label: 'WA Business License Application', b2b: 'Included', lz: 'Not included', zb: 'Not included' },
  { label: 'Trade name (DBA)', b2b: 'Included', lz: 'Not included', zb: 'Not included' },
  { label: 'EIN', b2b: 'Included', lz: 'Included', zb: 'Included' },
  { label: 'Renews every year', b2b: 'No', lz: 'No', zb: 'Yes, $199/yr' },
  { label: 'Local Washington team', b2b: 'Yes', lz: 'No', zb: 'No' },
];

const steps = [
  { num: '01', title: 'Tell us about your business', body: 'Fill out our short online request with your name choices, owners and addresses. Questions first? Book a free consultation.' },
  { num: '02', title: 'Review & e-sign', body: 'We email your work order and service agreement to review and sign online, then check name availability.' },
  { num: '03', title: 'We file', body: 'We file with the Secretary of State and Department of Revenue and obtain your EIN.' },
  { num: '04', title: 'You’re open for business', body: 'You get your formation documents, business license, EIN and next-steps checklist.' },
];

const faqs = [
  { q: 'Does the $400 really include the state fees?', a: 'Yes. The $400 flat rate includes the $200 Certificate of Formation fee, the Washington Business License Application fee and one trade name. City licenses, state endorsements and specialty licenses are not included and are billed at the actual government fee.' },
  { q: 'What are city licenses and endorsements?', a: 'Many Washington cities require their own business license, and some industries need state endorsements or specialty licenses. These are added to your state business license application and carry their own fees, which vary by city and business type.' },
  { q: 'What is a trade name (DBA)?', a: 'A trade name lets you do business under a name other than your legal LLC name. We always recommend at least one, typically your company name without "LLC." One is included, and additional trade names are $5 each (the state fee).' },
  { q: 'Do you form LLCs outside Washington?', a: 'Not at this time. Our LLC formation service is for Washington businesses only.' },
  { q: 'What happens after my LLC is formed?', a: 'You get your formation documents, business license, EIN and a checklist of next steps. B2B Solutions can also help with bookkeeping, payroll and HR as your business grows.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title="Washington LLC Formation for $400 Flat">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header />

  <main>
    <!-- Hero -->
    <section id="top" class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-wrap items-center gap-14">
        <div class="flex-1 min-w-[320px] flex flex-col gap-6">
          <span class="self-start bg-white text-navy font-semibold text-sm px-4 py-2 rounded-full border border-[#CFE0F7]">
            Washington LLC formation
          </span>
          <h1 class="font-heading font-extrabold text-[40px] md:text-[60px] leading-[1.05] text-navy tracking-tight">
            Your Washington LLC.<br /><span class="text-accent">$400 flat.</span><br />State fees included.
          </h1>
          <p class="text-muted text-xl max-w-lg">
            One price covers your state filing, business license application, trade name and EIN. No add-ons at checkout and no yearly subscription.
          </p>
          <div class="flex flex-wrap gap-3.5">
            <a href={startURL} class="bg-accent text-white no-underline font-bold px-7 py-4 rounded-full text-lg hover:bg-navy transition-colors">
              Start your LLC
            </a>
            <a href="#compare" class="bg-white text-navy no-underline font-bold px-7 py-4 rounded-full text-lg border-2 border-navy hover:bg-sky2 transition-colors">
              Compare &amp; save
            </a>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2.5 text-base text-muted">
            <span>&#10003; State fees included</span>
            <span>&#10003; Trade name &amp; EIN included</span>
            <span>&#10003; Local Washington team</span>
          </div>
        </div>

        <!-- Hero card -->
        <div class="flex-1 min-w-[320px] bg-white rounded-[20px] p-7 shadow-[0_20px_50px_rgba(11,37,69,0.12)] flex flex-col gap-[18px]">
          <div class="flex justify-between items-center">
            <div class="font-heading font-bold text-lg text-navy">Basic Washington LLC</div>
            <div class="text-sm text-success bg-[#E3F6EE] px-3 py-1 rounded-full font-semibold">All-in</div>
          </div>
          <div class="font-heading font-extrabold text-6xl text-navy">$400</div>
          <ul class="flex flex-col gap-2.5">
            {included.map((item) => (
              <li class="flex gap-3 items-start">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F7A55" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class="shrink-0 mt-1"><path d="M5 12l5 5 9-10"></path></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-sm text-muted">City licenses, state endorsements and specialty licenses are additional.</p>
        </div>
      </div>
    </section>

    <!-- Compare -->
    <section id="compare" class="bg-white scroll-mt-24">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-10">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Compare &amp; save</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">See what you actually pay</h2>
          <p class="text-xl text-muted">
            National services advertise low starting prices, then add state fees and charge extra for what a Washington LLC needs. Here is a basic Washington LLC with an EIN, side by side.
          </p>
        </div>

        <div class="overflow-x-auto rounded-[18px] border border-[#E3ECF7]">
          <table class="w-full min-w-[640px] text-left border-collapse">
            <thead>
              <tr>
                <th class="p-5 bg-sky2 font-heading text-navy text-base"></th>
                <th class="p-5 bg-navy text-white font-heading text-lg">B2B Solutions</th>
                <th class="p-5 bg-sky2 font-heading text-navy text-lg">LegalZoom Pro</th>
                <th class="p-5 bg-sky2 font-heading text-navy text-lg">ZenBusiness Pro</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map((r) => (
                <tr class="border-t border-[#E3ECF7]">
                  <td class="p-5 font-semibold text-navy">{r.label}</td>
                  <td class="p-5 bg-[#F0F7FF] font-semibold text-success">{r.b2b}</td>
                  <td class="p-5 text-muted">{r.lz}</td>
                  <td class="p-5 text-muted">{r.zb}</td>
                </tr>
              ))}
              <tr class="border-t-2 border-navy">
                <td class="p-5 font-heading font-extrabold text-navy text-lg">Starting first-year cost</td>
                <td class="p-5 bg-[#F0F7FF] font-heading font-extrabold text-navy text-2xl">$400</td>
                <td class="p-5 font-heading font-bold text-navy text-xl">$449+</td>
                <td class="p-5 font-heading font-bold text-navy text-xl">$399+</td>
              </tr>
              <tr class="border-t border-[#E3ECF7]">
                <td class="p-5 font-semibold text-navy">Plus business license &amp; trade name you file yourself</td>
                <td class="p-5 bg-[#F0F7FF] font-semibold text-success">$0</td>
                <td class="p-5 text-muted">+ $55</td>
                <td class="p-5 text-muted">+ $55</td>
              </tr>
              <tr class="border-t-2 border-navy">
                <td class="p-5 font-heading font-extrabold text-navy text-lg">Total to be ready to do business</td>
                <td class="p-5 bg-[#F0F7FF] font-heading font-extrabold text-navy text-2xl">$400</td>
                <td class="p-5 font-heading font-bold text-navy text-xl">$504</td>
                <td class="p-5 font-heading font-bold text-navy text-xl">$454</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <div class="bg-sky2 rounded-[18px] p-7 flex flex-col gap-2">
            <div class="font-heading font-extrabold text-3xl text-accent">Save $104</div>
            <div class="text-muted">compared to LegalZoom Pro, with the business license and trade name already done for you.</div>
          </div>
          <div class="bg-sky2 rounded-[18px] p-7 flex flex-col gap-2">
            <div class="font-heading font-extrabold text-3xl text-accent">Save $54 the first year</div>
            <div class="text-muted">compared to ZenBusiness Pro, and $199 every year after, since our price doesn't renew.</div>
          </div>
        </div>

        <p class="text-sm text-muted">
          Competitor prices are based on published Washington LLC rates as of November 2026 and may change. Comparison assumes online filing of the Certificate of Formation ($200), the $50 Washington Business License Application fee and one $5 trade name. LegalZoom and ZenBusiness are trademarks of their respective owners; B2B Solutions is not affiliated with them.
        </p>
      </div>
    </section>

    <!-- Why an LLC -->
    <section id="why" class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-12">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Why form an LLC</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Start your business on the right foundation</h2>
          <p class="text-xl text-muted">
            Setting up your LLC correctly from the beginning saves headaches later with banks, taxes and the state.
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {whyCards.map((card) => (
            <div class="bg-white rounded-[18px] p-7 flex flex-col gap-3">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1660D0" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={card.icon}></path></svg>
              <h3 class="font-heading text-xl text-navy">{card.title}</h3>
              <p class="text-muted">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="bg-white scroll-mt-24">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-12">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">What's included</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Everything a basic Washington LLC needs, for one price</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <div class="bg-sky2 rounded-[18px] p-7 flex gap-[18px]">
              <div class="shrink-0 w-12 h-12 rounded-xl bg-accent text-white font-heading font-extrabold text-xl flex items-center justify-center">{s.num}</div>
              <div>
                <h3 class="font-heading text-xl text-navy mb-1.5">{s.title}</h3>
                <p class="text-muted">{s.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Fees callout -->
    <section class="bg-navy text-white">
      <div class="max-w-6xl mx-auto px-6 py-16 md:py-18 flex flex-wrap gap-10 items-center">
        <div class="flex-1 min-w-[320px] flex flex-col gap-3.5">
          <div class="text-[#8EC2FF] font-bold text-sm tracking-widest uppercase">Know before you file</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[38px] leading-tight">What's not included</h2>
          <p class="text-lg text-[#D6E4F5]">
            Some businesses need more than a basic state license. If yours does, we'll tell you up front and add only the actual government fee.
          </p>
        </div>
        <div class="flex-1 min-w-[320px] grid gap-4 sm:grid-cols-2">
          <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
            <div class="font-heading font-bold text-lg mb-1.5">City licenses</div>
            <div class="text-[#D6E4F5] text-base">Many Washington cities require their own business license, with fees set by the city.</div>
          </div>
          <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
            <div class="font-heading font-bold text-lg mb-1.5">State endorsements</div>
            <div class="text-[#D6E4F5] text-base">Some industries need state endorsements or specialty licenses, each with its own fee.</div>
          </div>
          <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
            <div class="font-heading font-bold text-lg mb-1.5">Extra trade names</div>
            <div class="text-[#D6E4F5] text-base">One is included. Additional trade names are $5 each, the state fee.</div>
          </div>
          <div class="bg-white/[0.08] border border-white/[0.18] rounded-2xl p-[22px]">
            <div class="font-heading font-bold text-lg mb-1.5">Expedited filing</div>
            <div class="text-[#D6E4F5] text-base">Available if you need it faster, for the state's expedite fee.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="bg-sky scroll-mt-24">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-12">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">How it works</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Four simple steps to your Washington LLC</h2>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {steps.map((step) => (
            <div class="bg-white rounded-[18px] p-7 flex flex-col gap-2.5">
              <div class="font-heading font-extrabold text-[44px] text-accent leading-none">{step.num}</div>
              <h3 class="font-heading text-xl text-navy">{step.title}</h3>
              <p class="text-muted">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Guides -->
    <section id="guides" class="bg-white scroll-mt-24">
      <div class="max-w-6xl mx-auto px-6 pt-20 md:pt-24 flex flex-col gap-10">
        <div class="flex flex-wrap gap-4 justify-between items-end">
          <div class="max-w-2xl flex flex-col gap-4">
            <div class="text-accent font-bold text-sm tracking-widest uppercase">Washington LLC guides</div>
            <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Know what you're signing up for</h2>
          </div>
          <a href="/guides" class="font-bold text-lg text-accent no-underline hover:text-navy">All guides &rarr;</a>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {guides.map((g) => (
            <a href={`/${g.slug}`} class="no-underline text-ink bg-sky2 rounded-[18px] p-7 flex flex-col gap-3 border border-transparent hover:border-[#9CC3F5] transition-colors">
              <h3 class="font-heading text-xl text-navy">{g.short}</h3>
              <p class="text-muted">{g.blurb}</p>
              <span class="font-bold text-accent mt-auto">Read the guide &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="bg-white scroll-mt-24">
      <div class="max-w-3xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-8">
        <div class="flex flex-col gap-4 text-center">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Questions</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Frequently asked questions</h2>
        </div>
        <div class="flex flex-col gap-3.5">
          {faqs.map((f) => (
            <div class="bg-sky2 rounded-2xl px-7 py-6">
              <h3 class="font-heading text-xl text-navy mb-2">{f.q}</h3>
              <p class="text-muted">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-accent text-white">
      <div class="max-w-4xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-5 items-center text-center">
        <h2 class="font-heading font-extrabold text-3xl md:text-[46px] leading-tight">Ready to make it official?</h2>
        <p class="text-xl text-[#EAF3FF] max-w-xl">Form your Washington LLC for $400 flat, state fees included. Start online in a few minutes, or book a free consultation if you have questions.</p>
        <div class="flex flex-wrap gap-3.5 justify-center">
          <a href={startURL} class="bg-white text-navy no-underline font-bold px-8 py-4 rounded-full text-lg hover:bg-sky2 transition-colors">Start your LLC</a>
          <a href={bookingURL} class="bg-transparent text-white no-underline font-bold px-8 py-4 rounded-full text-lg border-2 border-white hover:bg-white/10 transition-colors">Book a free consultation</a>
          <a href="tel:3605292672" class="bg-transparent text-white no-underline font-bold px-8 py-4 rounded-full text-lg border-2 border-white hover:bg-white/10 transition-colors">Call 360-529-2672</a>
        </div>
        <p class="text-sm text-[#EAF3FF] max-w-xl">$400 covers a basic Washington LLC. City licenses, state endorsements, specialty licenses and additional trade names are extra.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
