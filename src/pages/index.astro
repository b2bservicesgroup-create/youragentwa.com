---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { guides } from '../data/guides';
import { whyCards, included, startURL } from '../data/site';

const explore = [
  { href: '/compare', title: 'Compare & save', body: 'See the real first-year cost next to LegalZoom and ZenBusiness, state fees included.', cta: 'Compare prices' },
  { href: '/whats-included', title: "What's included", body: 'State filing, business license, trade name and EIN, plus what costs extra.', cta: 'See what you get' },
  { href: '/how-it-works', title: 'How it works', body: 'Four steps from a short online request to your documents, license and EIN.', cta: 'See the steps' },
  { href: '/faq', title: 'Questions', body: 'Straight answers on fees, city licenses, trade names and what happens next.', cta: 'Read the FAQ' },
];

// Tells Google which name to show above our results (the "site name").
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'YourAgentWA',
  alternateName: ['YourAgentWA.com', 'Your Agent WA'],
  url: 'https://youragentwa.com',
};
---

<Layout
  title="Washington LLC Formation for $400 Flat"
  fullTitle="Form a Washington LLC for $400 Flat, State Fees Included"
  description="One flat $400 covers your Washington LLC: the state filing fee, Certificate of Formation, business license, trade name and EIN. Local help in Rochester, WA."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <Header />

  <main>
    <!-- Hero -->
    <section id="top" class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-wrap items-center gap-14">
        <div class="flex-1 min-w-[320px] flex flex-col gap-6">
          <span class="self-start bg-white text-navy font-semibold text-sm px-4 py-2 rounded-full border border-[#CFE0F7]">
            Washington LLC formation
          </span>
          <h1 class="font-heading font-extrabold text-[40px] md:text-[60px] leading-[1.05] text-navy tracking-tight">
            Your Washington LLC.<br /><span class="text-accent">$400 flat.</span><br />State fees included.
          </h1>
          <p class="text-muted text-xl max-w-lg">
            One price covers your state filing, business license application, trade name and EIN. No add-ons at checkout and no yearly subscription.
          </p>
          <div class="flex flex-wrap gap-3.5">
            <a href={startURL} class="bg-accent text-white no-underline font-bold px-7 py-4 rounded-full text-lg hover:bg-navy transition-colors">
              Start your LLC
            </a>
            <a href="/compare" class="bg-white text-navy no-underline font-bold px-7 py-4 rounded-full text-lg border-2 border-navy hover:bg-sky2 transition-colors">
              Compare &amp; save
            </a>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2.5 text-base text-muted">
            <span>&#10003; State fees included</span>
            <span>&#10003; Trade name &amp; EIN included</span>
            <span>&#10003; Local Washington team</span>
          </div>
        </div>

        <!-- Hero card -->
        <div class="flex-1 min-w-[320px] bg-white rounded-[20px] p-7 shadow-[0_20px_50px_rgba(11,37,69,0.12)] flex flex-col gap-[18px]">
          <div class="flex justify-between items-center">
            <div class="font-heading font-bold text-lg text-navy">Basic Washington LLC</div>
            <div class="text-sm text-success bg-[#E3F6EE] px-3 py-1 rounded-full font-semibold">All-in</div>
          </div>
          <div class="font-heading font-extrabold text-6xl text-navy">$400</div>
          <ul class="flex flex-col gap-2.5">
            {included.map((item) => (
              <li class="flex gap-3 items-start">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0F7A55" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" class="shrink-0 mt-1"><path d="M5 12l5 5 9-10"></path></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-sm text-muted">City licenses, state endorsements and specialty licenses are additional.</p>
        </div>
      </div>
    </section>

    <!-- Why an LLC -->
    <section id="why" class="bg-sky">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-12">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Why form an LLC</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Start your business on the right foundation</h2>
          <p class="text-xl text-muted">
            Setting up your LLC correctly from the beginning saves headaches later with banks, taxes and the state.
          </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {whyCards.map((card) => (
            <div class="bg-white rounded-[18px] p-7 flex flex-col gap-3">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#1660D0" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={card.icon}></path></svg>
              <h3 class="font-heading text-xl text-navy">{card.title}</h3>
              <p class="text-muted">{card.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Explore: links to the stand-alone section pages -->
    <section class="bg-white">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-10">
        <div class="max-w-2xl flex flex-col gap-4">
          <div class="text-accent font-bold text-sm tracking-widest uppercase">Before you start</div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Everything you need to decide</h2>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {explore.map((e) => (
            <a href={e.href} class="no-underline text-ink bg-sky2 rounded-[18px] p-7 flex flex-col gap-3 border border-transparent hover:border-[#9CC3F5] transition-colors">
              <h3 class="font-heading text-xl text-navy">{e.title}</h3>
              <p class="text-muted">{e.body}</p>
              <span class="font-bold text-accent mt-auto">{e.cta} &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Guides -->
    <section id="guides" class="bg-white scroll-mt-24">
      <div class="max-w-6xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-10">
        <div class="flex flex-wrap gap-4 justify-between items-end">
          <div class="max-w-2xl flex flex-col gap-4">
            <div class="text-accent font-bold text-sm tracking-widest uppercase">Washington LLC guides</div>
            <h2 class="font-heading font-extrabold text-3xl md:text-[44px] leading-tight text-navy">Know what you're signing up for</h2>
          </div>
          <a href="/guides" class="font-bold text-lg text-accent no-underline hover:text-navy">All guides &rarr;</a>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {guides.map((g) => (
            <a href={`/${g.slug}`} class="no-underline text-ink bg-sky2 rounded-[18px] p-7 flex flex-col gap-3 border border-transparent hover:border-[#9CC3F5] transition-colors">
              <h3 class="font-heading text-xl text-navy">{g.short}</h3>
              <p class="text-muted">{g.blurb}</p>
              <span class="font-bold text-accent mt-auto">Read the guide &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CtaBand />
  </main>

  <Footer />
</Layout>
