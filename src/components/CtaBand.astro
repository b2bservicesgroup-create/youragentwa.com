---
import { bookingURL, startURL } from '../data/site';
---

<!-- CTA -->
<section class="bg-accent text-white">
  <div class="max-w-4xl mx-auto px-6 py-20 md:py-24 flex flex-col gap-5 items-center text-center">
    <h2 class="font-heading font-extrabold text-3xl md:text-[46px] leading-tight">Ready to make it official?</h2>
    <p class="text-xl text-[#EAF3FF] max-w-xl">Form your Washington LLC for $400 flat, state fees included. Start online in a few minutes, or book a free consultation if you have questions.</p>
    <div class="flex flex-wrap gap-3.5 justify-center">
      <a href={startURL} class="bg-white text-navy no-underline font-bold px-8 py-4 rounded-full text-lg hover:bg-sky2 transition-colors">Start your LLC</a>
      <a href={bookingURL} class="bg-transparent text-white no-underline font-bold px-8 py-4 rounded-full text-lg border-2 border-white hover:bg-white/10 transition-colors">Book a free consultation</a>
      <a href="tel:3605292672" class="bg-transparent text-white no-underline font-bold px-8 py-4 rounded-full text-lg border-2 border-white hover:bg-white/10 transition-colors">Call 360-529-2672</a>
    </div>
    <p class="text-sm text-[#EAF3FF] max-w-xl">$400 covers a basic Washington LLC. City licenses, state endorsements, specialty licenses and additional trade names are extra.</p>
  </div>
</section>
