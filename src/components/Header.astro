---
const navLinks = [
  { href: '/compare', label: 'Compare' },
  { href: '/whats-included', label: "What's included" },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/guides', label: 'Guides' },
  { href: '/faq', label: 'FAQ' },
];

const startURL = '/llc';
---

<!-- Top contact bar -->
<div class="bg-navy text-white text-sm">
  <div class="max-w-6xl mx-auto px-6 py-2.5 flex flex-wrap items-center justify-between gap-2 gap-x-6">
    <div>Washington LLC formation from B2B Solutions &middot; Rochester, WA</div>
    <div class="flex flex-wrap gap-5">
      <a href="tel:3605292672" class="text-white hover:text-sky no-underline">360-529-2672</a>
      <a href="sms:3605290761" class="text-white hover:text-sky no-underline">Text 360-529-0761</a>
      <a href="mailto:info@b2bsolutions.biz" class="text-white hover:text-sky no-underline">info@b2bsolutions.biz</a>
    </div>
  </div>
</div>

<!-- Nav -->
<header class="border-b border-[#E3ECF7] bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="flex items-center no-underline" aria-label="B2B Solutions — YourAgentWA.com home">
      <img src="/logo/b2b-logo.svg" alt="B2B Services Group" width="1112" height="250" class="h-16 md:h-20 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-7 font-semibold text-base">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="text-navy no-underline hover:text-accent">{label}</a>
      ))}
      <a
        href={startURL}
        class="bg-accent text-white no-underline px-5 py-3 rounded-full hover:bg-navy transition-colors"
      >
        Get started
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="lg:hidden p-2 rounded-md text-navy hover:bg-sky transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#E3ECF7] bg-white">
    <nav class="px-6 py-4 flex flex-col gap-3 font-semibold">
      {navLinks.map(({ href, label }) => (
        <a href={href} class="text-navy no-underline py-1">{label}</a>
      ))}
      <a
        href={startURL}
        class="bg-accent text-white no-underline text-center px-5 py-3 rounded-full mt-1"
      >
        Get started
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
