---
import { guides } from '../data/guides';
const year = new Date().getFullYear();
---

<footer class="bg-navy text-[#D6E4F5] text-base">
  <div class="max-w-6xl mx-auto px-6 pt-14 pb-8 flex flex-col gap-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-2.5">
        <img src="/logo/b2b-logo-white.svg" alt="B2B Services Group" width="1112" height="250" class="h-16 w-auto self-start" />
        <div>Washington LLC formation by B2B Solutions &mdash; big business solutions for small business success.</div>
      </div>
      <div class="flex flex-col gap-2">
        <div class="font-bold text-white">LLC formation</div>
        <a href="/llc" class="text-[#D6E4F5] no-underline hover:text-white">Start your LLC</a>
        <a href="/#top" class="text-[#D6E4F5] no-underline hover:text-white">$400 flat-rate LLC</a>
        <a href="/#compare" class="text-[#D6E4F5] no-underline hover:text-white">Compare &amp; save</a>
        <a href="/washington-trade-name-dba" class="text-[#D6E4F5] no-underline hover:text-white">Trade names (DBA)</a>
        <a href="/#services" class="text-[#D6E4F5] no-underline hover:text-white">EIN setup</a>
        <a href="/#faq" class="text-[#D6E4F5] no-underline hover:text-white">FAQ</a>
        <div class="font-bold text-white mt-3">Guides</div>
        {guides.map((g) => (
          <a href={`/${g.slug}`} class="text-[#D6E4F5] no-underline hover:text-white">{g.short}</a>
        ))}
      </div>
      <div class="flex flex-col gap-2">
        <div class="font-bold text-white">More from B2B Solutions</div>
        <a href="https://b2bsolutions.biz/solutions/payroll-administration" class="text-[#D6E4F5] no-underline hover:text-white">Payroll administration</a>
        <a href="https://b2bsolutions.biz/solutions/hr-solutions" class="text-[#D6E4F5] no-underline hover:text-white">HR solutions</a>
        <a href="https://washingtonbookkeeper.com" class="text-[#D6E4F5] no-underline hover:text-white">Bookkeeping</a>
        <a href="https://b2bsolutions.biz/" class="text-[#D6E4F5] no-underline hover:text-white">b2bsolutions.biz</a>
      </div>
      <div class="flex flex-col gap-2">
        <div class="font-bold text-white">Contact</div>
        <a href="tel:3605292672" class="text-[#D6E4F5] no-underline hover:text-white">360-529-2672</a>
        <a href="sms:3605290761" class="text-[#D6E4F5] no-underline hover:text-white">Text 360-529-0761</a>
        <a href="mailto:info@b2bsolutions.biz" class="text-[#D6E4F5] no-underline hover:text-white">info@b2bsolutions.biz</a>
        <div>Rochester, WA</div>
      </div>
    </div>
    <div class="border-t border-white/15 pt-5 text-sm">
      &copy; {year} B2B Solutions. All rights reserved. &middot; YourAgentWA.com
    </div>
  </div>
</footer>
